{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canvas-content.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowListName", "itemName", "description", "copy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workflowListName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "itemName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 240 },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "new": { "type": "string", "minLength": 1, "maxLength": 240 },
        "viewArtifact": { "type": "string", "minLength": 1, "maxLength": 240 },
        "artifactUnavailable": { "type": "string", "minLength": 1, "maxLength": 240 },
        "setupRequired": { "type": "string", "minLength": 1, "maxLength": 240 }
      },
      "required": ["new", "viewArtifact", "artifactUnavailable", "setupRequired"]
    }
  }
}
