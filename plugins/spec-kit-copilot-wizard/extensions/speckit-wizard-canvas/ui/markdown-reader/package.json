{
    "name": "speckit-canvas-markdown-reader-build",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Build-only reader assets for the existing Wizard and SDD canvases.",
    "license": "MIT",
    "packageManager": "npm@11.17.0",
    "engines": {
        "node": "^24.15.0 || >=26.0.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint --config eslint.config.mjs . ../../../../../../scripts/canvas-reader --no-error-on-unmatched-pattern",
        "test": "node --import tsx --test \"test/*.test.*\"",
        "test:tools": "node --test \"../../../../../../scripts/canvas-reader/test/*.test.mjs\"",
        "build:reader": "vite build",
        "build:parser": "vite build --config vite.parser.config.ts",
        "build": "npm run build:reader && npm run build:parser && node ../../../../../../scripts/canvas-reader/sync-assets.mjs && node ../../../../../../scripts/canvas-reader/sync-domain.mjs",
        "verify:package": "node ../../../../../../scripts/canvas-reader/sync-assets.mjs --verify && node ../../../../../../scripts/canvas-reader/sync-domain.mjs --verify",
        "test:browser": "playwright test --config ../../../../../../scripts/canvas-reader/playwright.config.mjs",
        "dev": "node ../../../../../../scripts/canvas-reader/serve-fixture.mjs",
        "stage:app": "node ../../../../../../scripts/canvas-reader/stage-app-fixture.mjs"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.63.0",
        "@types/jsdom": "30.0.0",
        "@types/node": "24.10.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "es-module-lexer": "2.3.2",
        "eslint": "10.9.1",
        "github-slugger": "2.0.0",
        "jsdom": "30.0.1",
        "lucide-react": "1.32.0",
        "mdast-util-to-string": "4.0.0",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "react-markdown": "10.1.0",
        "remark-gfm": "4.0.1",
        "tsx": "4.23.13",
        "typescript": "5.9.3",
        "typescript-eslint": "8.68.0",
        "unist-util-visit": "5.0.0",
        "vite": "8.0.16"
    }
}
