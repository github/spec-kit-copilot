{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase-outputs.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "byCommand"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "byCommand": {
      "type": "object",
      "propertyNames": { "pattern": "^speckit\\.[a-z0-9][a-z0-9.-]*$" },
      "additionalProperties": { "$ref": "#/$defs/pair" }
    }
  },
  "$defs": {
    "pair": {
      "type": "object", "additionalProperties": false,
      "required": ["expectsArtifact", "outputPath"],
      "properties": {
        "expectsArtifact": { "type": ["boolean", "null"] },
        "outputPath": { "type": ["string", "null"] }
      }
    }
  }
}
