{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canvas-theme.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "colors", "typography", "density", "shape", "brand"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "positive": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "attention": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "critical": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      },
      "required": ["accent", "positive", "attention", "critical"]
    },
    "typography": { "enum": ["system", "sans", "serif"] },
    "density": { "enum": ["comfortable", "compact"] },
    "shape": { "enum": ["rounded", "square"] },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logo"],
      "properties": {
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["default", "asset", "none"] },
            "path": { "type": "string", "minLength": 1 },
            "alt": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      }
    }
  }
}
