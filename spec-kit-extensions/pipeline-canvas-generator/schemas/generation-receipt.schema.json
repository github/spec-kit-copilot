{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-receipt.schema.json",
  "title": "Generated extension integrity receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canvasId", "generator", "requestSha256", "blueprintSha256", "experienceSha256", "categories", "warnings", "logo", "runtimeProviders", "provenance", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "canvasId": { "type": "string", "minLength": 1 },
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "templateVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "templateVersion": { "type": "string", "minLength": 1 }
      }
    },
    "requestSha256": { "$ref": "#/$defs/hash" },
    "blueprintSha256": { "$ref": "#/$defs/hash" },
    "experienceSha256": { "$ref": "#/$defs/hash" },
    "categories": {
      "type": "object", "additionalProperties": false,
      "required": ["canvas-content", "canvas-theme", "canvas-layout", "canvas-interactions", "canvas-results", "canvas-onboarding"],
      "properties": {
        "canvas-content": { "$ref": "#/$defs/category" },
        "canvas-theme": { "$ref": "#/$defs/category" },
        "canvas-layout": { "$ref": "#/$defs/category" },
        "canvas-interactions": { "$ref": "#/$defs/category" },
        "canvas-results": { "$ref": "#/$defs/category" },
        "canvas-onboarding": { "$ref": "#/$defs/category" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "logo": { "type": "object" },
    "runtimeProviders": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "id", "version"],
        "properties": {
          "kind": { "enum": ["preset", "extension"] },
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "name", "stack"],
        "properties": {
          "kind": { "enum": ["command", "template", "script"] },
          "name": { "type": "string", "minLength": 1 },
          "stack": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "category": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "version", "sha256", "sourcePath", "sourceSha256"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "sha256": { "$ref": "#/$defs/hash" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
