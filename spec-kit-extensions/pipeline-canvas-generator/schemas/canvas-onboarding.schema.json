{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canvas-onboarding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowSlug", "installationMode", "approvalCopy", "readinessCopy", "firstRunCopy", "helpCopy", "recoveryCopy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workflowSlug": { "type": "object", "additionalProperties": false, "required": ["userProvided", "label", "helperText"], "properties": { "userProvided": { "type": "boolean" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "helperText": { "type": "string", "minLength": 1, "maxLength": 240 } } },
    "installationMode": { "enum": ["external", "prompt", "automatic"] },
    "approvalCopy": { "$ref": "#/$defs/copy" },
    "readinessCopy": { "$ref": "#/$defs/copy" },
    "firstRunCopy": { "$ref": "#/$defs/copy" },
    "helpCopy": { "$ref": "#/$defs/copy" },
    "recoveryCopy": { "$ref": "#/$defs/copy" }
  },
  "$defs": { "copy": { "type": "string", "minLength": 1, "maxLength": 240 } }
}
