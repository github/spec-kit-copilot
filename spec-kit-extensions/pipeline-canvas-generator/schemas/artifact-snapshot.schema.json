{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-snapshot.schema.json",
  "title": "Normalized Specify artifact snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "compositionFingerprint", "providers", "artifacts", "packageClassifications"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "compositionFingerprint": { "$ref": "#/$defs/sha256" },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "version", "priority", "enabled", "source", "manifestPath"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["preset", "extension"] },
          "version": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer" },
          "enabled": { "type": "boolean" },
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          },
          "manifestPath": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "stack"],
        "properties": {
          "kind": { "enum": ["command", "template", "script"] },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "stack": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "layer", "strategy", "active", "hidden", "manifestPath", "lookupId", "sourcePath"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "sourceId": { "type": ["string", "null"] },
                "layer": { "enum": ["core", "preset", "extension", "project", null] },
                "strategy": { "enum": ["replace", "wrap", "prepend", "append"] },
                "active": { "type": "boolean" },
                "hidden": { "type": "boolean" },
                "manifestPath": { "type": ["string", "null"] },
                "lookupId": { "type": ["string", "null"] },
                "sourcePath": { "type": ["string", "null"] },
                "presetId": { "type": ["string", "null"] },
                "presetName": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "packageClassifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "tags", "classification", "manifestPath"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["preset", "extension"] },
          "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "classification": { "enum": ["canvas-design", "runtime"] },
          "manifestPath": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
