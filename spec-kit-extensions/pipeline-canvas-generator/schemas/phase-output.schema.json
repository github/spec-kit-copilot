{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase-output.schema.json",
  "title": "Author-declared phase output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandName", "result"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commandName": {
      "type": "string",
      "pattern": "^speckit\\.[a-z0-9][a-z0-9.-]*$"
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pathTemplate"],
          "properties": {
            "kind": { "const": "artifact" },
            "pathTemplate": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\.md$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "transient" } }
        }
      ]
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phaseId", "contract", "provider", "sourcePath", "sha256", "templateStack"],
      "properties": {
        "phaseId": { "type": "string", "minLength": 1 },
        "contract": { "$ref": "#" },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "version"],
          "properties": {
            "kind": { "enum": ["preset", "extension", "project"] },
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": ["string", "null"] }
          }
        },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "templateStack": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "layer", "strategy", "active", "hidden", "manifestPath", "lookupId", "sourcePath"],
            "properties": {
              "id": { "type": "string" },
              "sourceId": { "type": ["string", "null"] },
              "layer": { "enum": ["project", "preset", "extension", "core", null] },
              "strategy": { "enum": ["replace", "wrap", "prepend", "append"] },
              "active": { "type": "boolean" },
              "hidden": { "type": "boolean" },
              "manifestPath": { "type": ["string", "null"] },
              "lookupId": { "type": ["string", "null"] },
              "sourcePath": { "type": ["string", "null"] },
              "presetId": { "type": ["string", "null"] },
              "presetName": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
