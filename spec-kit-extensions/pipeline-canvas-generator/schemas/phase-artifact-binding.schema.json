{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase-artifact-binding.schema.json",
  "$defs": {
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["commandName", "expectsArtifact", "outputPath"],
      "properties": {
        "commandName": { "type": "string", "pattern": "^speckit\\.[a-z0-9][a-z0-9.-]*$" },
        "expectsArtifact": { "type": ["boolean", "null"] },
        "outputPath": { "type": ["string", "null"] }
      }
    }
  }
}
