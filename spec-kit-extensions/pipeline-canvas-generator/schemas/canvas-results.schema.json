{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canvas-results.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "phases", "clarification", "progress"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "resultLabels": {
      "type": "array", "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "defaultResult": { "$ref": "#/$defs/result" },
    "phases": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/result" },
          {
            "type": "object", "additionalProperties": false,
            "required": ["disabled"],
            "properties": { "disabled": { "const": true } }
          }
        ]
      }
    },
    "clarification": { "type": "object", "additionalProperties": false, "required": ["enabled", "label"], "properties": { "enabled": { "type": "boolean" }, "label": { "type": "string", "minLength": 1, "maxLength": 60 } } },
    "progress": { "type": "object", "additionalProperties": false, "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "values", "source", "summary"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "values": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "label", "tone"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "tone": { "enum": ["neutral", "info", "positive", "attention", "critical"] }
            }
          }
        },
        "source": {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {
            "kind": { "enum": ["artifact-field", "phase-report"] },
            "field": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" }
          }
        },
        "summary": { "type": "boolean" }
      }
    }
  }
}
